# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# ── Gmail (Nodemailer) ────────────────────────────────────────────────────────
# Use your Gmail address and a Google App Password (NOT your regular password).
# How to get an App Password:
#   1. Go to myaccount.google.com > Security > 2-Step Verification (enable it first)
#   2. Then go to myaccount.google.com/apppasswords
#   3. Create a new app password for "Mail"
#   4. Copy the 16-character code — paste it below (no spaces)
GMAIL_USER=pythonvb6@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ── Android SMS Gateway ───────────────────────────────────────────────────────
# Install "Android SMS Gateway" app on your Android phone (09692573933).
# The app runs a local HTTP server. For it to work from Vercel (cloud):
#   Option A: Use ngrok — run `ngrok http 8080` on your phone's network and paste the https URL below.
#   Option B: Use the app's built-in cloud relay (check app settings for a relay URL).
#   Option C: Self-host on a VPS with port forwarding from your phone.
#
# Local URL (only works during vercel dev on the same network):
SMS_GATEWAY_URL=http://192.168.1.xxx:8080
# OR ngrok/cloud URL (works from Vercel production):
# SMS_GATEWAY_URL=https://xxxx.ngrok-free.app

SMS_GATEWAY_USER=admin
SMS_GATEWAY_PASS=your-sms-gateway-password

# ── Reminder cron auth ────────────────────────────────────────────────────────
# Any long random string. Set this in Vercel env vars AND in your cron config
# if you call /api/reminders via an external scheduler instead of Vercel crons.
REMINDER_SECRET=another-long-random-string
